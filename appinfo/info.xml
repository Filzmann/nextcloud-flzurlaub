<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>flzurlaub</id>
    <name>Filzmann Urlaubsplanung</name>
    <summary>Urlaubsplanung für alle Filzmann-Fachgruppen.</summary>
    <description>Plant und genehmigt ganztägige Urlaubszeiträume und stellt sie anderen lokalen Apps read-only bereit.</description>
    <version>0.7.0-rc.2</version>
    <licence>agpl</licence>
    <author>Filzmann Software</author>
    <namespace>FlzUrlaub</namespace>
    <category>organization</category>
    <website>https://github.com/Filzmann/flz-full-suite</website>
    <bugs>https://github.com/Filzmann/nextcloud-flzurlaub/issues</bugs>
    <repository type="git">https://github.com/Filzmann/nextcloud-flzurlaub</repository>
    <dependencies>
        <php min-version="8.3"/>
        <nextcloud min-version="33" max-version="35"/>
    </dependencies>
    <commands><command>OCA\FlzUrlaub\Command\SeedDemoCommand</command></commands>
    <settings>
        <admin>OCA\FlzUrlaub\Settings\Admin</admin>
        <admin-section>OCA\FlzUrlaub\Settings\AdminSection</admin-section>
    </settings>
</info>
